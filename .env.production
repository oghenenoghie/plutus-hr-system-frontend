# Production build defaults — not secret (these are public, client-side values).
# Override per-deployment via a real env var if the backend URL ever changes.
NEXT_PUBLIC_API_BASE_URL=https://plutus-api-production-5678.up.railway.app/api/v1

# Real login/writes against the live backend are now viable (CORS fixed on
# the API, and accounts can be seeded via .github/workflows/seed-login.yml
# in plutus-hr-system) — mock mode is off by default. Set to 1 only for a
# preview build with no backend at all; see src/lib/api/mock-fixtures.ts.
NEXT_PUBLIC_MOCK_MODE=
