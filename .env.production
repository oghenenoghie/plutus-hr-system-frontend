# Production build defaults — not secret (these are public, client-side values).
# Override per-deployment via a real env var if the backend URL ever changes.
NEXT_PUBLIC_API_BASE_URL=https://plutus-api-production-5678.up.railway.app/api/v1

# TEMPORARY: skips login and renders every screen from mock-fixtures.ts while
# real-account seeding is sorted out separately. Flip to empty/0 (or delete
# this line) to require real login again — see src/lib/api/mock-fixtures.ts
# and README.md's "Getting started" section.
NEXT_PUBLIC_MOCK_MODE=1
