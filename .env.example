# Base URL of the plutus-hr-system FastAPI backend, including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Set to 1 to preview the UI with canned fixture data (src/lib/api/mock-fixtures.ts)
# instead of a live backend — no login required. Leave unset otherwise.
NEXT_PUBLIC_MOCK_MODE=
